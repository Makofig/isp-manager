includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - app
        - config
        - database
        - routes
        - tests
    excludePaths:
        - bootstrap/
        - node_modules (?)
        - public/build (?)
        - storage/
        - vendor/
